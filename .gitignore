# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

/src/generated/prisma
.env

# local workspace artifacts
.vscode/
memory/
/HANDOFF.md
update_catalog_and_bom.py
.claude/settings.local.json

# TOOL-001 — handoff Claude Code ↔ GPT Reviewer
# IMPORTANTE: os 5 arquivos canônicos em ai/ (README + project-state + current-task +
# claude-report + gpt-review + decision-log) DEVEM ser commitados — não ignorar.
# Aqui ignoramos apenas artefatos transitórios e cache.
ai/*.tmp
ai/.cache/

# Playwright MCP runtime artifacts
# .playwright-mcp/ é cache local de sessões; playwright-trace/ contém snapshots de
# página YAML que podem capturar tokens públicos Mapbox renderizados no DOM.
# Evidências formais (PNGs e screenshots) ficam em docs/relatorios/evidencias/<TASK>/.
.playwright-mcp/
playwright-trace/

# Propostas comerciais reais e dados de clientes (PII/contratos — nunca versionar)
docs/PROJETO/
