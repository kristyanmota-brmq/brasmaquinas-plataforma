# Brasmáquinas — variáveis de ambiente necessárias
# Copie para .env.local e preencha os valores reais.

# Mapbox — token público usado pelo mapa e pela geocodificação (forward + reverse)
# Obter em: https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=

# Clerk — autenticação
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Banco de dados
DATABASE_URL=

# GPT Reviewer (TOOL-001 — handoff Claude Code ↔ GPT)
# Usado por: node scripts/ai/run-gpt-review.mjs
# Documentação: ai/README.md
OPENAI_API_KEY=
# OPENAI_MODEL é obrigatório — sem default no código. Exemplos: gpt-5, gpt-4.1, gpt-4o.
OPENAI_MODEL=
# Opcional — default https://api.openai.com/v1 quando vazio.
OPENAI_BASE_URL=
